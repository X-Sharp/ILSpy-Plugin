<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Name>ILSpy.XSharpLanguage</Name>
    <Dialect>Core</Dialect>
    <Allowdot>true</Allowdot>
    <NamedArgs>True</NamedArgs>
    <CS>True</CS>
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ILSpy.XSharpLanguage</RootNamespace>
    <AssemblyName>ILSpy.XSharpLanguage.Plugin</AssemblyName>
    <OutputName>ILSpy.XSharpLanguage</OutputName>
    <Nologo>true</Nologo>
    <GenerateFullPaths>true</GenerateFullPaths>
    <Nullable>enable</Nullable>
    <StartupObject />
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <NoWin32Manifest>false</NoWin32Manifest>
    <VulcanCompatibleResources>false</VulcanCompatibleResources>
    <Version>10.1.0</Version>
    <AssemblyVersion>10.1.0.0</AssemblyVersion>
    <FileVersion>10.1.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebuggerCommand>$(SolutionDir)\ILSpy_Core\ILSpy.exe</DebuggerCommand>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <CommandLineOption>/allowdot-</CommandLineOption>
    <PreBuildEvent />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <CommandLineOption>/allowdot-</CommandLineOption>
    <PreBuildEvent />
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ICSharpCode.AvalonEdit">
      <HintPath>..\ILSpy_Core\ICSharpCode.AvalonEdit.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ICSharpCode.Decompiler">
      <HintPath>..\ILSpy_Core\ICSharpCode.Decompiler.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ICSharpCode.ILSpyX">
      <HintPath>..\ILSpy_Core\ICSharpCode.ILSpyX.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ILSpy">
      <HintPath>..\ILSpy_Core\ILSpy.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>..\ILSpy_Core\Mono.Cecil.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TomsToolbox.Composition">
      <HintPath>..\ILSpy_Core\TomsToolbox.Composition.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TomsToolbox.Wpf.Composition.AttributedModel">
      <HintPath>..\ILSpy_Core\TomsToolbox.Wpf.Composition.AttributedModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Composition.AttributedModel">
      <HintPath>..\ILSpy_Core\System.Composition.AttributedModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude XSharpOptionPage.xaml from Page compilation to avoid MarkupCompilePass1 crash with Language="X#" -->
  <ItemGroup>
    <Page Remove="XSharpOptionPage.xaml" />
    <Page Include="XSharpOptionPage.xaml" />
  </ItemGroup>

</Project>
